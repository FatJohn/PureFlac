root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:suggestion
dotnet_diagnostic.IDE0007.severity = warning

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_diagnostic.IDE0003.severity = warning

csharp_style_namespace_declarations = block_scoped:warning
dotnet_diagnostic.IDE0160.severity = warning

csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0065.severity = warning

csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning
dotnet_diagnostic.IDE0036.severity = warning

dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA2213.severity = warning
dotnet_diagnostic.CA1307.severity = warning

[tests/**.cs]
# xUnit test names use underscores (Method_Condition_ExpectedResult).
dotnet_diagnostic.CA1707.severity = none
# Constant arrays in test data are clearer inline than cached in static fields.
dotnet_diagnostic.CA1861.severity = none
# Short-lived streams in tests are released by using blocks or at method end.
dotnet_diagnostic.CA2000.severity = none

[*.{json,yml,yaml,props,csproj,slnx}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{sh,py}]
indent_style = space
